---
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import IntroLogo from '../components/IntroLogo.astro';
import Nav from '../components/Nav.astro';

export type Props = HeadProps & { showHeader?: boolean; showIntro?: boolean };

const { showHeader = true, showIntro = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased break-words">
    <head>
        <!-- Google Tag Manager -->
        <script>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-TBPPQSG2');
        </script>

        <!-- End Google Tag Manager -->
        <BaseHead {...head} />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
        <script is:inline data-astro-rerun>
            document.documentElement.classList.add('js');
            if (localStorage.theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        </script>
        <script is:inline define:vars={{ showIntro }}>
            try {
                const isFirstPage = sessionStorage.getItem('pr-site-loaded') !== 'true';
                const forceIntro = new URLSearchParams(window.location.search).get('intro') === '1';
                const canAnimate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (showIntro && (isFirstPage || forceIntro) && canAnimate) {
                    document.documentElement.classList.add('pr-intro-pending');
                }
                sessionStorage.setItem('pr-site-loaded', 'true');
            } catch {
                // If storage is unavailable, prefer loading the site normally.
            }
        </script>
        <ClientRouter />
    </head>
    <body class="bg-main text-main">
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TBPPQSG2" height="0" width="0" style="display:none;visibility:hidden"
            ></iframe></noscript
        >
        <!-- End Google Tag Manager (noscript) -->
        <!-- Actual page content -->
        <div class="flex flex-col min-h-screen px-4 md:px-8 relative z-10" id="site-shell">
            <Nav />
            <main class="grow w-full max-w-3xl mx-auto">
                <slot />
            </main>
            <Footer />
        </div>
        {showIntro && <IntroLogo />}
        <script is:inline>
            document.addEventListener('astro:page-load', () => {
                const toggleBtn = document.getElementById('companion-toggle');

                function spawnCompanion() {
                    if (document.getElementById('oneko')) return;
                    const script = document.createElement('script');
                    script.src = '/Other/Oneko/oneko.js';
                    script.dataset.dynamic = 'true';
                    document.body.appendChild(script);
                }

                function removeCompanion() {
                    const cat = document.getElementById('oneko');
                    if (cat) cat.remove();
                    document.querySelectorAll('script[data-dynamic="true"]').forEach((s) => s.remove());
                }

                function updateCompanionState() {
                    const enabled = localStorage.getItem('companion-enabled') === 'true';
                    if (enabled) spawnCompanion();
                    else removeCompanion();
                }

                toggleBtn?.addEventListener('click', () => {
                    const currentlyEnabled = localStorage.getItem('companion-enabled') === 'true';
                    localStorage.setItem('companion-enabled', (!currentlyEnabled).toString());
                    updateCompanionState();
                });

                updateCompanionState();
            });
        </script>
        <script>
            document.addEventListener('astro:page-load', () => {
                const els = document.querySelectorAll('.reveal');
                if (els.length === 0) return;
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    els.forEach((el) => el.classList.add('is-visible'));
                    return;
                }
                const io = new IntersectionObserver(
                    (entries, observer) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                observer.unobserve(entry.target);
                            }
                        }
                    },
                    { rootMargin: '0px 0px -10% 0px' }
                );
                els.forEach((el) => io.observe(el));
            });
        </script>
    </body>
</html>
