---
import { type CollectionEntry, render } from 'astro:content';
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import Compare from '../components/Compare.astro';
import ContactSheet from '../components/ContactSheet.astro';
import FilmstripViewer from '../components/FilmstripViewer.astro';
import Gallery from '../components/Gallery.astro';
import InteractiveDashboard from '../components/InteractiveDashboard.astro';
import MediaEmbed from '../components/MediaEmbed.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import TogglePanels from '../components/TogglePanels.astro';
import BaseLayout from './BaseLayout.astro';
import { slugify } from '../utils/common-utils';

type Props = {
    project: CollectionEntry<'projects'>;
    prevProject: CollectionEntry<'projects'> | null;
    nextProject: CollectionEntry<'projects'> | null;
};

const { project, prevProject, nextProject } = Astro.props;
const { title, description, poster, tags, category, role, tools, links, publishDate, seo } = project.data;
const { Content } = await render(project);

const year = publishDate.getFullYear();
const primaryCategory = category ?? tags[0];
const specCols = [primaryCategory, true, role, tools.length > 0, links].filter(Boolean).length;
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description} image={seo?.image} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        {poster && (
            <div class="hero-bleed hero-tape relative mb-8 px-4 md:px-8 sm:mb-10">
                <div class="mx-auto max-w-5xl overflow-hidden rounded-lg border border-main/20 shadow-lg" style="box-shadow: 0 24px 48px -20px var(--card-shadow);">
                    <img src={poster} alt="" class="aspect-[4/3] w-full object-cover sm:aspect-[21/9]" loading="eager" decoding="async" />
                </div>
            </div>
        )}

        <header class="mb-8">
            <h1 class="text-2xl leading-tight font-display heading-accent sm:text-4xl sm:leading-tight">{title}</h1>
        </header>

        <dl class="spec-strip mb-10 sm:mb-12" style={`--spec-strip-cols: ${Math.max(specCols, 1)};`}>
            {primaryCategory && (
                <div>
                    <dt>Category</dt>
                    <dd>{primaryCategory}</dd>
                </div>
            )}
            <div>
                <dt>Year</dt>
                <dd>{year}</dd>
            </div>
            {role && (
                <div>
                    <dt>Role</dt>
                    <dd>{role}</dd>
                </div>
            )}
            {tools.length > 0 && (
                <div>
                    <dt>Tools</dt>
                    <dd class="flex flex-wrap gap-1.5">
                        {tools.map((tool) => (
                            <a
                                href={`/tags/${slugify(tool)}`}
                                class="inline-flex items-center rounded-full border border-accent/40 px-2.5 py-0.5 text-xs leading-tight transition hover:border-accent hover:bg-accent hover:text-bg-main focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                            >
                                {tool}
                            </a>
                        ))}
                    </dd>
                </div>
            )}
            {links && (links.github || links.demo || links.paper) && (
                <div>
                    <dt>Links</dt>
                    <dd class="flex flex-wrap gap-x-4 gap-y-1">
                        {links.github && (
                            <a href={links.github} target="_blank" rel="noreferrer" class="hover:text-accent hover:underline hover:underline-offset-2">
                                GitHub
                            </a>
                        )}
                        {links.demo && (
                            <a href={links.demo} target="_blank" rel="noreferrer" class="hover:text-accent hover:underline hover:underline-offset-2">
                                Demo
                            </a>
                        )}
                        {links.paper && (
                            <a href={links.paper} target="_blank" rel="noreferrer" class="hover:text-accent hover:underline hover:underline-offset-2">
                                Paper
                            </a>
                        )}
                    </dd>
                </div>
            )}
        </dl>

        <div class="max-w-none prose sm:prose-lg">
            <Content components={{ InteractiveDashboard, Compare, Gallery, MediaEmbed, Callout, Button, FilmstripViewer, ContactSheet, TogglePanels }} />
        </div>
    </article>
    {(prevProject || nextProject) && (
        <div class="my-16 sm:my-24">
            <h2 class="mb-12 text-lg font-display heading-accent sm:mb-16 sm:text-xl">View Next</h2>
            {nextProject && <ProjectPreview project={nextProject} class="mb-10 sm:mb-12" headingLevel="h3" />}
            {prevProject && <ProjectPreview project={prevProject} class="mb-10 sm:mb-12" headingLevel="h3" />}
        </div>
    )}
</BaseLayout>
