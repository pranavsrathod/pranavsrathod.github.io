---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';

type Props = { 
  project: CollectionEntry<'projects'>; 
  index?: number; // not used in this version
  class?: string; 
  headingLevel?: 'h2' | 'h3'
};

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description, poster } = project.data;
const TitleTag = headingLevel;
---

<a class:list={['flex flex-col sm:flex-row items-center gap-8 group', className]} href={`/projects/${project.id}/`}>
  {poster && (
    <figure class="sm:w-1/2">
      <img 
        class="w-full object-cover mx-auto" 
        src={poster} 
        alt="Project Poster" 
        loading="lazy" 
        decoding="async" 
      />
    </figure>
  )}
  <div class={`sm:w-1/2 ${poster ? (poster ? 'sm:pl-4' : '') : ''} text-center`}>
    <TitleTag class="text-xl leading-tight font-medium group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-2xl">
      {title}
    </TitleTag>
    {description && (
      <div class="mt-1 text-sm leading-normal">{description}</div>
    )}
    <div class="mt-4 text-sm font-medium opacity-0 transition group-hover:opacity-100 sm:block">
      View Project <ArrowRight class="fill-current w-4 h-4 inline-block" />
    </div>
  </div>
</a>