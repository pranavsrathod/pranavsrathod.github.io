---
import { type CollectionEntry } from 'astro:content';

type Props = {
    project: CollectionEntry<'projects'>;
    class?: string;
    headingLevel?: 'h2' | 'h3';
    variant?: 'archive' | 'featured' | 'featured-lead';
};

const { project, class: className, headingLevel = 'h2', variant = 'archive' } = Astro.props;
const { title, description, poster } = project.data;
const TitleTag = headingLevel;
---

<a class:list={['blueprint-card project-card', `blueprint-card--${variant}`, className]} href={`/projects/${project.id}/`}>
    <span class="corner-mark corner-mark--tl" aria-hidden="true"></span>
    <span class="corner-mark corner-mark--tr" aria-hidden="true"></span>
    <span class="corner-mark corner-mark--bl" aria-hidden="true"></span>
    <span class="corner-mark corner-mark--br" aria-hidden="true"></span>

    {
        poster && (
            <div class="blueprint-thumbnail">
                <img src={poster} alt="" loading="lazy" decoding="async" />
                <span class="thumbnail-grid" aria-hidden="true" />
            </div>
        )
    }

    <div class="blueprint-copy">
        <TitleTag>{title}</TitleTag>
        {description && <p>{description}</p>}
    </div>
</a>

<style>
    .blueprint-card {
        position: relative;
        display: flex;
        min-width: 0;
        flex-direction: column;
        overflow: clip;
        border: 1px solid color-mix(in oklab, var(--blueprint-ink) 58%, transparent);
        border-radius: 0.125rem;
        background-color: color-mix(in oklab, var(--blueprint-paper) 88%, transparent);
        background-image:
            linear-gradient(color-mix(in oklab, var(--blueprint-ink) 6%, transparent) 1px, transparent 1px),
            linear-gradient(90deg, color-mix(in oklab, var(--blueprint-ink) 6%, transparent) 1px, transparent 1px);
        background-size: 20px 20px;
        box-shadow: 0 5px 18px -15px var(--card-shadow);
        color: var(--text-main);
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            translate 0.25s ease;
    }

    .blueprint-card::after {
        content: '';
        position: absolute;
        z-index: 3;
        right: -18%;
        bottom: -2px;
        left: -18%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0) rotate(-0.4deg);
        transform-origin: left;
        transition: transform 0.45s ease;
    }

    .blueprint-card:hover,
    .blueprint-card:focus-visible {
        border-color: var(--blueprint-ink);
        box-shadow: 8px 12px 24px -18px var(--card-shadow);
        translate: 0 -2px;
    }

    .blueprint-card:hover::after,
    .blueprint-card:focus-visible::after {
        transform: scaleX(1) rotate(-0.4deg);
    }

    .blueprint-card:focus-visible {
        outline: 2px dashed var(--accent);
        outline-offset: 4px;
    }

    .corner-mark {
        position: absolute;
        z-index: 4;
        width: 0.65rem;
        height: 0.65rem;
        pointer-events: none;
        border-color: var(--blueprint-ink);
    }

    .corner-mark--tl {
        top: 0.35rem;
        left: 0.35rem;
        border-top: 1px solid;
        border-left: 1px solid;
    }

    .corner-mark--tr {
        top: 0.35rem;
        right: 0.35rem;
        border-top: 1px solid;
        border-right: 1px solid;
    }

    .corner-mark--bl {
        bottom: 0.35rem;
        left: 0.35rem;
        border-bottom: 1px solid;
        border-left: 1px solid;
    }

    .corner-mark--br {
        right: 0.35rem;
        bottom: 0.35rem;
        border-right: 1px solid;
        border-bottom: 1px solid;
    }

    .blueprint-thumbnail {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid color-mix(in oklab, var(--blueprint-ink) 58%, transparent);
        background: color-mix(in oklab, var(--blueprint-ink) 9%, var(--bg-muted));
    }

    .blueprint-thumbnail img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        filter: saturate(0.84) contrast(1.03);
        transition:
            filter 0.3s ease,
            transform 0.45s ease;
    }

    .blueprint-card:hover .blueprint-thumbnail img,
    .blueprint-card:focus-visible .blueprint-thumbnail img {
        filter: saturate(1) contrast(1.01);
        transform: scale(1.018);
    }

    .thumbnail-grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(90deg, transparent calc(50% - 0.5px), color-mix(in oklab, var(--blueprint-ink) 30%, transparent) 50%, transparent calc(50% + 0.5px)),
            linear-gradient(transparent calc(50% - 0.5px), color-mix(in oklab, var(--blueprint-ink) 30%, transparent) 50%, transparent calc(50% + 0.5px));
        opacity: 0.35;
        transition: opacity 0.25s ease;
    }

    .blueprint-card:hover .thumbnail-grid,
    .blueprint-card:focus-visible .thumbnail-grid {
        opacity: 0.7;
    }

    .blueprint-copy {
        display: flex;
        min-width: 0;
        flex: 1;
        flex-direction: column;
        gap: 0.65rem;
        padding: 1.1rem;
    }

    .blueprint-copy h2,
    .blueprint-copy h3 {
        max-width: 22ch;
        font-family: var(--font-serif);
        font-size: clamp(1.35rem, 3vw, 1.75rem);
        font-weight: 520;
        line-height: 1;
        letter-spacing: -0.025em;
    }

    .blueprint-copy p {
        display: -webkit-box;
        overflow: hidden;
        color: var(--text-muted);
        font-size: 0.8125rem;
        line-height: 1.5;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    @media (min-width: 640px) {
        .blueprint-card--featured-lead {
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
        }

        .blueprint-card--featured-lead .blueprint-thumbnail {
            min-height: 100%;
            border-right: 1px solid color-mix(in oklab, var(--blueprint-ink) 58%, transparent);
            border-bottom: 0;
        }

        .blueprint-card--featured-lead .blueprint-thumbnail img {
            height: 100%;
            min-height: 19rem;
            aspect-ratio: auto;
        }

        .blueprint-card--featured-lead .blueprint-copy {
            justify-content: center;
            padding: 1.5rem;
        }

        .blueprint-card--featured-lead .blueprint-copy h2,
        .blueprint-card--featured-lead .blueprint-copy h3 {
            font-size: clamp(1.75rem, 3.5vw, 2.35rem);
        }

        .blueprint-card--featured-lead .blueprint-copy p {
            -webkit-line-clamp: 6;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .blueprint-card,
        .blueprint-card::after,
        .blueprint-thumbnail img,
        .thumbnail-grid {
            transition: none;
        }

        .blueprint-card:hover,
        .blueprint-card:focus-visible {
            translate: 0;
        }
    }
</style>
