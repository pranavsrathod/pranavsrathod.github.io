---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks || [];
---

<nav class="relative min-h-11 pt-4 pb-8 sm:min-h-14 sm:pb-12 md:pt-8">
    {
        navLinks.length > 0 && (
            <div class="relative mx-auto flex w-full max-w-3xl items-center gap-3 md:gap-8">
                <a class="font-display text-lg leading-none text-accent relative z-30" href="/" aria-label="Pranav Rathod, Home" id="site-logo">
                    PR.
                </a>
                <button
                    class="menu-toggle relative z-30 -ml-1 flex h-11 w-11 cursor-pointer items-center justify-center md:hidden"
                    aria-label="Open Menu"
                    aria-expanded="false"
                    aria-controls="menu-items"
                >
                    <span class="menu-toggle-icon w-6 h-px relative bg-current" />
                </button>
                <ul
                    id="menu-items"
                    class="menu flex gap-6 max-md:fixed max-md:inset-0 max-md:z-20 max-md:h-[100dvh] max-md:flex-col max-md:items-start max-md:gap-2 max-md:overflow-y-auto max-md:bg-main max-md:px-4 max-md:pt-24 max-md:pb-8"
                >
                    {navLinks.map((link) => (
                        <li class="w-full py-1 md:w-auto">
                            <NavLink class="inline-flex min-h-11 items-center text-2xl font-medium text-main md:min-h-0 md:text-sm" href={link.href}>
                                {link.text}
                            </NavLink>
                        </li>
                    ))}
                </ul>
            </div>
        )
    }
    <div class="absolute right-0 top-4 z-30 flex items-center md:top-8">
        <button
            id="companion-toggle"
            class="ml-1 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-main hover:bg-muted md:ml-3 md:h-8 md:w-8"
            aria-label="Summon Cat"
        >
            <svg class="w-4 h-4" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="3" width="2" height="2" />
                <rect x="2" y="1" width="2" height="2" />
                <rect x="5" y="0" width="2" height="2" />
                <rect x="8" y="1" width="2" height="2" />
                <rect x="10" y="3" width="2" height="2" />
                <rect x="4" y="4" width="4" height="1" />
                <rect x="3" y="5" width="6" height="3" />
                <rect x="4" y="8" width="4" height="1" />
            </svg>
        </button>
        <ThemeToggle />
    </div>
</nav>

<style>
    @reference "tailwindcss";

    @media (max-width: 767px) {
        .menu {
            @apply invisible pointer-events-none opacity-0;
            background-image: radial-gradient(var(--dot-grid) 1px, transparent 1px);
            background-size: 24px 24px;
            transform: translateY(-0.75rem);
            transition:
                visibility 0s linear 0.2s,
                opacity 0.2s ease,
                transform 0.2s ease;
        }
        .menu.is-visible {
            @apply visible pointer-events-auto opacity-100;
            transform: translateY(0);
            transition:
                opacity 0.2s ease,
                transform 0.2s ease;
        }
        .menu-toggle-icon {
            transition: background-color 0.15s ease;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            background-color: transparent;
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 1.5rem;
            height: 1px;
            transform-origin: center;
            background-color: currentColor;
            transition: transform 0.2s ease;
        }
        .menu-toggle-icon:before {
            transform: translate(-50%, -50%) translateY(-0.375rem);
        }
        .menu-toggle-icon:after {
            transform: translate(-50%, -50%) translateY(0.375rem);
        }
        .menu-toggle.is-active .menu-toggle-icon:before {
            transform: translate(-50%, -50%) rotate(45deg);
        }
        .menu-toggle.is-active .menu-toggle-icon:after {
            transform: translate(-50%, -50%) rotate(-45deg);
        }

        :global(body.menu-open) {
            overflow: hidden;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .menu,
        .menu.is-visible,
        .menu-toggle-icon,
        .menu-toggle-icon::before,
        .menu-toggle-icon::after {
            transition: none;
        }
    }
</style>

<script>
    function initializeMenu() {
        const menu = document.querySelector<HTMLElement>('.menu');
        const menuToggleBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
        if (!menu || !menuToggleBtn || menuToggleBtn.dataset.initialized === 'true') return;

        const menuWindow = window as Window & { cleanupMobileMenu?: () => void };
        menuWindow.cleanupMobileMenu?.();
        menuToggleBtn.dataset.initialized = 'true';
        const mobileQuery = window.matchMedia('(max-width: 767px)');

        function setMenuOpen(open: boolean, returnFocus = false) {
            const shouldOpen = open && mobileQuery.matches;
            menuToggleBtn?.classList.toggle('is-active', shouldOpen);
            menuToggleBtn?.setAttribute('aria-expanded', String(shouldOpen));
            menuToggleBtn?.setAttribute('aria-label', shouldOpen ? 'Close Menu' : 'Open Menu');
            menu?.classList.toggle('is-visible', shouldOpen);
            menu?.setAttribute('aria-hidden', mobileQuery.matches ? String(!shouldOpen) : 'false');
            document.body.classList.toggle('menu-open', shouldOpen);
            if (returnFocus) menuToggleBtn?.focus();
        }

        setMenuOpen(false);

        menuToggleBtn.addEventListener('click', () => {
            setMenuOpen(menuToggleBtn.getAttribute('aria-expanded') !== 'true');
        });

        menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
        menu.addEventListener('click', (event) => {
            if (event.target === menu) setMenuOpen(false, true);
        });
        function handleKeydown(event: KeyboardEvent) {
            if (event.key === 'Escape' && menuToggleBtn.getAttribute('aria-expanded') === 'true') {
                setMenuOpen(false, true);
            }
        }

        function handleBreakpointChange() {
            setMenuOpen(false);
        }

        document.addEventListener('keydown', handleKeydown);
        mobileQuery.addEventListener('change', handleBreakpointChange);
        menuWindow.cleanupMobileMenu = () => {
            document.removeEventListener('keydown', handleKeydown);
            mobileQuery.removeEventListener('change', handleBreakpointChange);
            document.body.classList.remove('menu-open');
        };
    }

    initializeMenu();
    document.addEventListener('astro:after-swap', initializeMenu);
</script>
