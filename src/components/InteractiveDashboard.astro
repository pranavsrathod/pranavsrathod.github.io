---
// src/components/InteractiveDashboard.astro
type SectionType = 'cards' | 'team' | 'steps' | 'chart' | 'list' | 'html';

interface Section {
    id: string;
    label: string;
    type: SectionType;
    cards?: {
        icon?: string; // SVG icon name from ICON_SVGS (e.g. "code", "cpu", "layers")
        image?: { src: string; alt?: string; className?: string };
        title: string;
        desc?: string;
        html?: string;
        details?: { label: string; value: string }[];
        actions?: { type?: 'link' | 'button'; icon: 'github' | 'linkedin' | 'link' | string; href?: string; label?: string; onClickId?: string }[];
    }[];
    steps?: {
        label: string;
        sub: string;
        detail: string;
        image?: { src: string; alt?: string };
        details?: { label: string; value: string }[];
    }[];
    chart?: { labels: string[]; datasets: any[]; insight?: string };
    list?: {
        id: string | number;
        tag?: string;
        title: string;
        summary: string;
        href?: string;
        linkLabel?: string;
    }[];
    html?: string; // Supports KaTeX math via $...$ (inline) and $$...$$ (block)
}

interface Props {
    id: string;
    sections: Section[];
}

const { id, sections } = Astro.props;

// ─── SVG ICON LIBRARY ────────────────────────────────────────────────────────
// Usage: set icon: "code" | "cpu" | "layers" | "eye" | "git" | "settings" etc.
// on cards. Falls back to a neutral dot if name not found.
const ICON_SVGS: Record<string, string> = {
