    wand: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"/></svg>`,
    music: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z"/></svg>`,
    film: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0 1 12 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M13.125 12h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125M20.625 12c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5M12 14.625v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 14.625c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m0 1.5v-1.5m0 0c0-.621.504-1.125 1.125-1.125m0 0h7.5"/></svg>`,
    gamepad: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z"/></svg>`,
    robot: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z"/></svg>`,
    math: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.745 3A23.933 23.933 0 0 0 3 12c0 3.183.62 6.22 1.745 9M19.255 3A23.933 23.933 0 0 1 21 12c0 3.183-.62 6.22-1.745 9M8.25 8.885l1.444-.89a.75.75 0 0 1 1.105.402l2.402 7.206a.75.75 0 0 0 1.104.401l1.445-.889m-8.25.75.213.09a1.687 1.687 0 0 0 2.062-.617l4.45-6.676a1.688 1.688 0 0 1 2.062-.618l.213.09"/></svg>`,
    // Generic fallback
    dot: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-3 h-3"><circle cx="12" cy="12" r="4"/></svg>`
};

function getIconSvg(name?: string) {
    if (!name) return ICON_SVGS.link;
    return ICON_SVGS[name.toLowerCase()] ?? ICON_SVGS.dot;
}
---

<!-- KaTeX for math rendering in html sections -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div
    class="not-prose my-8 border border-slate-200 dark:border-zinc-700 rounded-xl overflow-hidden shadow-sm bg-white dark:bg-zinc-900 interactive-dashboard"
    id={`dash-${id}`}
>
    <!-- NAV TABS -->
    <div class="bg-slate-100 dark:bg-zinc-800 p-4 border-b border-slate-200 dark:border-zinc-700 flex flex-wrap gap-2 justify-center nav-container">
        {
            sections.map((section, index) => (
                <button
                    data-target={section.id}
                    class={`px-3 py-1 text-xs uppercase font-bold tracking-wider rounded transition-colors ${index === 0 ? 'active-tab bg-slate-800 text-white dark:bg-white dark:text-black shadow-sm' : 'opacity-50 hover:opacity-100'}`}
                >
                    {section.label}
                </button>
            ))
        }
    </div>

    <!-- CONTENT -->
    <div class="p-6 min-h-[400px]">
        {
            sections.map((section, index) => (
                <div id={`${id}-${section.id}`} class={`tab-section ${index !== 0 ? 'hidden' : ''} space-y-6`}>
                    {/* ── CARDS ── */}
                    {section.type === 'cards' && section.cards && (
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[420px] overflow-y-auto pr-2 custom-scroll">
                            {section.cards.map((c) => (
                                <div class="p-4 rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-800/50">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="flex items-start gap-3 min-w-0">
                                            {/* Image takes priority, then SVG icon, then nothing */}
                                            {c.image?.src ? (
                                                <img
                                                    src={c.image.src}
                                                    alt={c.image.alt || ''}
                                                    class:list={[
                                                        'w-16 h-16 rounded-lg object-cover shrink-0 border border-slate-200 dark:border-zinc-700',
                                                        c.image.className
                                                    ]}
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            ) : c.icon ? (
                                                <div class="shrink-0 w-8 h-8 flex items-center justify-center rounded-md border border-slate-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-slate-600 dark:text-slate-300">
                                                    <span set:html={getIconSvg(c.icon)} />
                                                </div>
                                            ) : null}

                                            <div class="font-medium text-base leading-snug">{c.title}</div>
                                        </div>

                                        {c.actions && c.actions.length > 0 && (
                                            <div class="flex items-center gap-2 pt-1 shrink-0">
                                                {c.actions.map((a) =>
                                                    a.href ? (
                                                        <a
                                                            href={a.href}
                                                            target="_blank"
                                                            rel="noreferrer"
                                                            class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-slate-200 dark:border-zinc-700 bg-slate-100 dark:bg-zinc-700 hover:bg-slate-200 dark:hover:bg-zinc-600 transition-colors"
                                                            aria-label={a.label || a.icon}
                                                            title={a.label || a.icon}
                                                        >
                                                            <span set:html={getIconSvg(a.icon)} />
                                                        </a>
                                                    ) : (
                                                        <button
                                                            type="button"
                                                            class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-slate-200 dark:border-zinc-700 bg-slate-100 dark:bg-zinc-700 hover:bg-slate-200 dark:hover:bg-zinc-600 transition-colors"
                                                            aria-label={a.label || a.icon}
                                                            title={a.label || a.icon}
                                                            data-action={a.onClickId || ''}
                                                        >
                                                            <span set:html={getIconSvg(a.icon)} />
                                                        </button>
                                                    )
                                                )}
                                            </div>
                                        )}
                                    </div>

                                    {c.desc && <p class="mt-2 text-sm opacity-80">{c.desc}</p>}
                                    {c.html && <div class="mt-2 text-sm opacity-80" set:html={c.html} />}

                                    {c.details && c.details.length > 0 && (
                                        <dl class="mt-3 text-sm grid grid-cols-1 gap-1">
                                            {c.details.map((d) => (
                                                <div class="flex gap-2">
                                                    <dt class="font-mono text-xs uppercase opacity-70 w-28 shrink-0">{d.label}</dt>
                                                    <dd class="opacity-85">{d.value}</dd>
                                                </div>
                                            ))}
                                        </dl>
                                    )}
                                </div>
                            ))}
                        </div>
                    )}

                    {/* ── TEAM ── */}
                    {section.type === 'team' && section.cards && (
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            {section.cards.map((m) => (
                                <div class="group p-4 rounded-xl border border-slate-200 dark:border-zinc-700 bg-white dark:bg-zinc-900/40 shadow-sm hover:shadow-md transition-shadow">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <div class="font-serif text-base leading-tight truncate">{m.title}</div>
                                            {m.desc && m.desc.trim().length > 0 && <div class="mt-1 text-xs opacity-70 leading-snug">{m.desc}</div>}
                                        </div>
                                        {m.actions && m.actions.length > 0 && (
                                            <div class="flex items-center gap-2 pt-0.5 shrink-0">
                                                {m.actions.map((a) =>
                                                    a.href ? (
                                                        <a
                                                            href={a.href}
                                                            target="_blank"
                                                            rel="noreferrer"
                                                            class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-slate-200 dark:border-zinc-700 bg-transparent hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors"
                                                            aria-label={a.label || a.icon}
                                                            title={a.label || a.icon}
                                                        >
                                                            <span set:html={getIconSvg(a.icon)} />
                                                        </a>
                                                    ) : (
                                                        <button
                                                            type="button"
                                                            class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-slate-200 dark:border-zinc-700 bg-transparent hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors"
                                                            aria-label={a.label || a.icon}
                                                            title={a.label || a.icon}
                                                            data-action={a.onClickId || ''}
                                                        >
                                                            <span set:html={getIconSvg(a.icon)} />
                                                        </button>
                                                    )
                                                )}
                                            </div>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}

                    {/* ── STEPS — vertical timeline with inline accordion ── */}
                    {section.type === 'steps' && section.steps && (
                        <div class="relative overflow-y-auto max-h-[600px] pr-2 custom-scroll">
                            {/* Vertical spine */}
                            <div class="absolute left-[19px] top-0 bottom-0 w-px bg-slate-200 dark:bg-zinc-700 pointer-events-none" aria-hidden="true" />

                            <ol class="relative space-y-0">
                                {section.steps.map((s, i) => (
                                    <li class="step-item">
                                        {/* Clickable header row */}
                                        <button
                                            class="step-btn group w-full text-left flex items-start gap-4 py-4 pr-2 transition-colors"
                                            data-detail={s.detail}
                                            data-details={s.details ? JSON.stringify(s.details) : ''}
                                            data-image-src={s.image?.src || ''}
                                            data-image-alt={s.image?.alt || ''}
                                            data-index={i}
                                            aria-expanded="false"
                                        >
                                            {/* Node on the spine */}
                                            <div class="step-node relative z-10 mt-0.5 flex-shrink-0 w-10 h-10 rounded-full border-2 border-slate-300 dark:border-zinc-600 bg-white dark:bg-zinc-900 flex items-center justify-center text-xs font-mono font-bold text-slate-400 dark:text-zinc-500 group-hover:border-blue-400 group-hover:text-blue-500 dark:group-hover:border-blue-500 dark:group-hover:text-blue-400 transition-colors">
                                                {String(i + 1).padStart(2, '0')}
                                            </div>

                                            <div class="flex-1 min-w-0 pt-1.5">
                                                <div class="font-semibold text-sm text-slate-800 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight">
                                                    {s.label}
                                                </div>
                                                <div class="text-xs opacity-60 mt-0.5 font-mono">{s.sub}</div>
                                            </div>

                                            {/* Chevron — rotates when open */}
                                            <div class="step-chevron mt-2.5 flex-shrink-0 opacity-40 group-hover:opacity-80 transition-all text-slate-500 dark:text-zinc-400">
                                                <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform duration-200">
                                                    <path
                                                        fill-rule="evenodd"
                                                        d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                                                        clip-rule="evenodd"
                                                    />
                                                </svg>
                                            </div>
                                        </button>

                                        {/* Inline expandable content — hidden by default */}
                                        <div class="step-expand hidden pl-14 pb-5 pr-2 space-y-3">
                                            {/* Description */}
                                            <p class="step-expand-text text-sm text-slate-700 dark:text-zinc-300 leading-relaxed" />

                                            {/* Full image if present */}
                                            <img
                                                class="step-expand-img hidden w-full rounded-lg border border-slate-200 dark:border-zinc-700 object-contain max-h-80"
                                                src=""
                                                alt=""
                                                loading="lazy"
                                                decoding="async"
                                            />

                                            {/* Key-value details */}
                                            <dl class="step-expand-dl hidden text-sm grid grid-cols-1 gap-1.5" />
                                        </div>
                                    </li>
                                ))}
                            </ol>
                        </div>
                    )}

                    {/* ── CHART ── */}
                    {section.type === 'chart' && (
                        <>
                            <div class="relative w-full h-[250px]">
                                <canvas id={`chart-${id}-${section.id}`} data-chart={JSON.stringify(section.chart)} />
                            </div>
                            {section.chart?.insight && <p class="text-xs text-center opacity-60 mt-2">{section.chart.insight}</p>}
                        </>
                    )}

                    {/* ── LIST ── */}
                    {section.type === 'list' && section.list && (
                        <div class="space-y-3 max-h-[300px] overflow-y-auto custom-scroll pr-2">
                            {section.list.map((item) => (
                                <div class="p-3 text-sm border rounded dark:border-zinc-700 bg-slate-50 dark:bg-zinc-800/30">
                                    {item.tag && <span class="text-xs font-mono uppercase text-blue-500 mb-1 block">[{item.tag}]</span>}
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="font-bold">{item.title}</div>
                                        {item.href && (
                                            <a
                                                href={item.href}
                                                target="_blank"
                                                rel="noreferrer"
                                                class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:underline text-xs bg-slate-100 dark:bg-zinc-700 hover:bg-slate-200 dark:hover:bg-zinc-600 rounded px-2 py-1 transition-colors"
                                                aria-label={item.linkLabel || 'Source'}
                                                title={item.linkLabel || 'Source'}
                                            >
                                                <span set:html={getIconSvg('link')} />
                                                {item.linkLabel || 'Source'}
                                            </a>
                                        )}
                                    </div>
                                    <div class="opacity-80 mt-1">{item.summary}</div>
                                </div>
                            ))}
                        </div>
                    )}

                    {/* ── HTML (with KaTeX math support) ── */}
                    {/*
                        Math syntax (inside html strings):
                          Inline:  $F(u,v) = \sum ...$
                          Block:   $$F(u,v) = \sum ...$$
                        KaTeX auto-render will process after mount.
                    */}
                    {section.type === 'html' && (
                        <div class="custom-html-content katex-content prose-sm dark:prose-invert max-w-none text-sm leading-relaxed" set:html={section.html} />
                    )}
                </div>
            ))
        }
    </div>
</div>

<style>
    /* ── Timeline active state ── */
    .step-btn.is-active .step-node {
        border-color: rgb(59 130 246);
        color: rgb(59 130 246);
        background-color: rgb(239 246 255);
    }
    .dark .step-btn.is-active .step-node {
        border-color: rgb(96 165 250);
        color: rgb(96 165 250);
        background-color: rgb(30 41 59);
    }
    .step-btn.is-active .step-chevron {
        opacity: 1;
        color: rgb(59 130 246);
    }

    /* ── KaTeX block equation centering ── */
    .katex-content .katex-display {
        margin: 1.25rem 0;
        overflow-x: auto;
    }
    .katex-content .katex-display > .katex {
        font-size: 1.05em;
    }

    /* ── Subtle scrollbar ── */
    .custom-scroll::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.15);
        border-radius: 2px;
    }
    .dark .custom-scroll::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
    }
</style>

<script define:vars={{ id }}>
    document.addEventListener('astro:page-load', () => {
        const root = document.getElementById(`dash-${id}`);
        if (!root) return;

        // ── TAB LOGIC ──────────────────────────────────────────────────────────
        const btns = root.querySelectorAll('.nav-container button');
        const tabSecs = root.querySelectorAll('.tab-section');

        btns.forEach((btn) => {
            btn.addEventListener('click', () => {
                btns.forEach((b) => {
                    b.classList.remove('active-tab', 'bg-slate-800', 'text-white', 'dark:bg-white', 'dark:text-black', 'shadow-sm');
                    b.classList.add('opacity-50', 'hover:opacity-100');
                });
                btn.classList.remove('opacity-50', 'hover:opacity-100');
                btn.classList.add('active-tab', 'bg-slate-800', 'text-white', 'dark:bg-white', 'dark:text-black', 'shadow-sm');

                const targetId = btn.dataset.target;
                tabSecs.forEach((s) => s.classList.add('hidden'));
                const active = document.getElementById(`${id}-${targetId}`);
                if (active) {
                    active.classList.remove('hidden');
                    initChartsIn(active);
                    renderMathIn(active);
                }
            });
        });

        // ── CHART LOGIC ────────────────────────────────────────────────────────
        function initChartsIn(container) {
            const canvas = container.querySelector('canvas');
            if (!canvas || canvas.dataset.initialized === 'true' || typeof Chart === 'undefined') return;
            const rawData = JSON.parse(canvas.dataset.chart);
            new Chart(canvas, {
                type: 'line',
                data: {
                    labels: rawData.labels,
                    datasets: rawData.datasets.map((ds) => ({
                        label: ds.label,
                        data: ds.data,
                        borderColor: ds.color,
                        borderDash: ds.dashed ? [5, 5] : [],
                        tension: 0.4,
                        fill: false
                    }))
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
            canvas.dataset.initialized = 'true';
        }

        // ── KATEX MATH RENDERING ───────────────────────────────────────────────
        function renderMathIn(container) {
            if (typeof renderMathInElement === 'undefined') return;
            const nodes = container.querySelectorAll('.katex-content');
            nodes.forEach((el) => {
                if (el.dataset.mathRendered === 'true') return;
                renderMathInElement(el, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false }
                    ],
                    throwOnError: false
                });
                el.dataset.mathRendered = 'true';
            });
        }

        // ── STEPS TIMELINE LOGIC ───────────────────────────────────────────────
        root.querySelectorAll('.step-btn').forEach((btn) => {
            btn.addEventListener('click', (e) => {
                const el = e.currentTarget;
                const item = el.closest('.step-item');
                const expand = item?.querySelector('.step-expand');
                const chevron = el.querySelector('.step-chevron svg');
                const isOpen = el.getAttribute('aria-expanded') === 'true';

                // Close all other open steps in this dashboard
                root.querySelectorAll('.step-btn[aria-expanded="true"]').forEach((other) => {
                    if (other === el) return;
                    other.setAttribute('aria-expanded', 'false');
                    other.classList.remove('is-active');
                    other.querySelector('.step-chevron svg')?.style.setProperty('transform', '');
                    other.closest('.step-item')?.querySelector('.step-expand')?.classList.add('hidden');
                });

                if (isOpen) {
                    // Collapse
                    el.setAttribute('aria-expanded', 'false');
                    el.classList.remove('is-active');
                    chevron?.style.setProperty('transform', '');
                    expand?.classList.add('hidden');
                } else {
                    // Expand
                    el.setAttribute('aria-expanded', 'true');
                    el.classList.add('is-active');
                    chevron?.style.setProperty('transform', 'rotate(180deg)');
                    expand?.classList.remove('hidden');

                    // Populate content (only needed once — check flag)
                    if (expand && !expand.dataset.populated) {
                        const textEl = expand.querySelector('.step-expand-text');
                        const imgEl = expand.querySelector('.step-expand-img');
                        const dl = expand.querySelector('.step-expand-dl');

                        if (textEl) textEl.textContent = el.dataset.detail || '';

                        const src = el.dataset.imageSrc || '';
                        if (imgEl && src) {
                            imgEl.src = src;
                            imgEl.alt = el.dataset.imageAlt || '';
                            imgEl.classList.remove('hidden');
                        }

                        if (dl) {
                            const rawDetails = el.dataset.details;
                            if (rawDetails) {
                                try {
                                    JSON.parse(rawDetails).forEach((d) => {
                                        const row = document.createElement('div');
                                        row.className = 'flex gap-2';
                                        const dt = document.createElement('dt');
                                        dt.className = 'font-mono text-xs uppercase opacity-60 w-28 shrink-0';
                                        dt.textContent = d.label;
                                        const dd = document.createElement('dd');
                                        dd.className = 'opacity-85';
                                        dd.textContent = d.value;
                                        row.append(dt, dd);
                                        dl.appendChild(row);
                                    });
                                    dl.classList.remove('hidden');
                                } catch {
                                    /* ignore */
                                }
                            }
                        }

                        expand.dataset.populated = 'true';
                    }
                }
            });
        });

        // Init on first visible section
        const firstSection = root.querySelector('.tab-section:not(.hidden)');
        if (firstSection) {
            initChartsIn(firstSection);
            renderMathIn(firstSection);
        }
    });
</script>
