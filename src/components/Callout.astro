---
interface Props {
    label?: string;
}

const { label } = Astro.props;
---

<div class="callout not-prose my-8 px-5 py-4 sm:px-6 sm:py-5">
    {label && <div class="mb-1.5 font-sans text-[0.6875rem] font-semibold tracking-widest text-accent uppercase">{label}</div>}
    <div class="text-base leading-relaxed sm:text-lg">
        <slot />
    </div>
</div>
