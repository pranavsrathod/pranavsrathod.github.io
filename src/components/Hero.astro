---
import { marked } from 'marked';
import siteConfig from '../data/site-config';
import ArrowRight from '../icons/ArrowRight.astro';
import Button from './Button.astro';
import PixelAvatar from './PixelAvatar.astro';

const hero = siteConfig.hero;
---

{
    (hero?.title || hero?.text || (hero?.actions && hero.actions.length > 0)) && (
        <section
            class="hero-bleed relative mb-12 sm:mb-20 flex flex-col justify-center px-4 md:px-8 min-h-[calc(100svh-5.5rem)] sm:min-h-[calc(100svh-7.5rem)] md:min-h-[calc(100svh-8.5rem)]"
            id="home-hero"
        >
            <div class="hero-inner mx-auto w-full max-w-5xl flex flex-col-reverse items-center gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:gap-12 sm:text-left">
                <div class="w-full min-w-0 flex flex-col items-center gap-5 sm:items-start">
                    <div class="flex flex-col gap-1">
                        <span class="text-base font-semibold uppercase tracking-[0.22em] sm:text-lg">{siteConfig.title}</span>
                        {siteConfig.subtitle && <span class="text-[0.8rem] tracking-wide text-muted">{siteConfig.subtitle.replaceAll('|', '/')}</span>}
                    </div>
                    {hero.title && (
                        <h1 class="text-3xl leading-tight font-display heading-accent max-sm:[&::after]:mx-auto sm:text-5xl sm:leading-tight lg:text-6xl lg:leading-tight">{hero.title}</h1>
                    )}
                    {hero.text && <div class="max-w-[52ch] prose prose-base sm:prose-lg" set:html={marked.parse(hero.text)} />}
                    <a class="group inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline hover:underline-offset-4" href="/about">
                        more about me <ArrowRight class="w-4 h-4 fill-current transition-transform group-hover:translate-x-0.5" />
                    </a>
                    {hero.actions && hero.actions.length > 0 && (
                        <div class="flex flex-wrap justify-center gap-4 sm:justify-start">
                            {hero.actions.map((action) => (
                                <Button
                                    href={action.href}
                                    {...(action.newTab && { target: '_blank', rel: 'noopener noreferrer' })}
                                >
                                    {action.text}
                                </Button>
                            ))}
                        </div>
                    )}
                </div>
                <div class="avatar-column shrink-0 flex flex-col items-center">
                    <div class="avatar-card" id="avatar-card">
                        <PixelAvatar />
                        <span class="avatar-tap-badge" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" />
                            </svg>
                        </span>
                    </div>
                    <div class="avatar-baseline" aria-hidden="true"></div>
                </div>
            </div>
            <div class="hero-scroll-cue absolute inset-x-0 bottom-5 flex flex-col items-center gap-1" id="hero-scroll-cue" aria-hidden="true">
                <span class="font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">scroll</span>
                <svg viewBox="0 0 24 24" class="h-4 w-4 text-accent" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                </svg>
            </div>
        </section>
    )
}

<style>
    /* Sticker-on-notebook card. The rotated card is a ::before layer BEHIND the
       sprite — the pixel art itself must stay axis-aligned to keep pixels crisp.
       The extra bottom/side inset keeps the rotated edge from rising above the
       sprite's flat bottom edge (2deg over this width shifts corners ~5px). */
    .avatar-card {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 1.5rem 1.75rem 0;
    }

    .avatar-card::before {
        content: '';
        position: absolute;
        inset: 0 -4px -5px;
        z-index: -1;
        border-radius: 1.25rem;
        background-color: var(--bg-muted);
        background-image: radial-gradient(var(--dot-grid) 1px, transparent 1px);
        background-size: 24px 24px;
        box-shadow: 0 10px 24px -8px var(--card-shadow);
        transform: rotate(2deg);
    }

    /* The marker line he stands on, plus a pencil-note caption */
    .avatar-baseline {
        width: 70%;
        height: 2px;
        margin-top: 0.625rem;
        border-radius: 9999px;
        background-color: var(--accent);
        transform: rotate(-0.6deg);
    }

    /* Phones: the avatar takes whatever height the text and buttons leave over,
       so the whole hero (buttons included) stays on the first screen. The column
       is a size container so the sprite can be sized from that leftover height. */
    @media (max-width: 639px) {
        #home-hero {
            padding-bottom: 3.5rem;
        }

        .hero-inner {
            flex: 1 1 auto;
        }

        .avatar-column {
            flex: 1 1 0;
            justify-content: center;
            width: 100%;
            min-height: 12.5rem;
            container-type: size;
        }

        .avatar-column :global(.pixel-avatar) {
            width: clamp(10rem, 100cqh - 2.5rem, min(68vw, 18rem));
            height: clamp(10rem, 100cqh - 2.5rem, min(68vw, 18rem));
        }
    }

    /* Touch-only affordance: hover devices discover the headphones on their own */
    .avatar-tap-badge {
        position: absolute;
        top: -0.6rem;
        right: -0.9rem;
        display: none;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 9999px;
        color: var(--bg-main);
        background-color: var(--accent);
        box-shadow: 0 6px 14px -6px var(--card-shadow);
        pointer-events: none;
        transform: rotate(8deg);
        transition:
            opacity 0.3s ease,
            scale 0.3s ease;
    }

    .avatar-tap-badge svg {
        width: 1.1rem;
        height: 1.1rem;
    }

    .avatar-tap-badge::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        border: 2px solid var(--accent);
        animation: avatar-tap-ping 2s cubic-bezier(0, 0, 0.2, 1) 1s infinite;
    }

    .avatar-card.is-discovered .avatar-tap-badge {
        opacity: 0;
        scale: 0.6;
    }

    @keyframes avatar-tap-ping {
        0% {
            opacity: 0.7;
            transform: scale(1);
        }
        70%,
        100% {
            opacity: 0;
            transform: scale(1.7);
        }
    }

    @media (hover: none) {
        .avatar-tap-badge {
            display: grid;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .avatar-tap-badge {
            display: none !important;
        }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        document
            .getElementById('avatar-card')
            ?.addEventListener('click', (event) => (event.currentTarget as HTMLElement).classList.add('is-discovered'), { once: true });

        const cue = document.getElementById('hero-scroll-cue');
        if (!cue) return;
        cue.classList.toggle('is-hidden', window.scrollY > 40);
        if ((window as any).heroCueBound) return;
        (window as any).heroCueBound = true;
        window.addEventListener(
            'scroll',
            () => {
                const el = document.getElementById('hero-scroll-cue');
                if (el) el.classList.toggle('is-hidden', window.scrollY > 40);
            },
            { passive: true }
        );
    });
</script>
