---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks || [];
---

<nav class="site-nav relative pt-4 pb-9 md:pt-6 md:pb-12" aria-label="Primary navigation">
    {
        navLinks.length > 0 && (
            <div class="masthead relative mx-auto grid w-full max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-3">
                <a class="brand-mark relative z-30 font-display text-lg leading-none text-accent" href="/" aria-label="Pranav Rathod, Home" id="site-logo">
                    PR.
                </a>

                <div id="menu-items" class="menu" aria-hidden="true">
                    <div class="menu-meta" aria-hidden="true">
                        <span>Index</span>
                        <span>01—{String(navLinks.length).padStart(2, '0')}</span>
                    </div>
                    <ul class="menu-list">
                        {navLinks.map((link, index) => (
                            <li class="menu-item">
                                <span class="menu-number" aria-hidden="true">
                                    {String(index + 1).padStart(2, '0')}
                                </span>
                                <NavLink class="masthead-link" href={link.href}>
                                    {link.text}
                                </NavLink>
                            </li>
                        ))}
                    </ul>
                    <p class="menu-edition" aria-hidden="true">Pranav Rathod · Portfolio / 2026</p>
                </div>

                <div class="nav-tools relative z-30 ml-auto flex items-center">
                    <span class="tools-label" aria-hidden="true">Utilities</span>
                    <button id="companion-toggle" class="tool-button" aria-label="Summon Cat">
                        <svg
                            class="h-4 w-4"
                            viewBox="0 0 12 12"
                            fill="currentColor"
                            shape-rendering="crispEdges"
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <rect x="0" y="3" width="2" height="2" />
                            <rect x="2" y="1" width="2" height="2" />
                            <rect x="5" y="0" width="2" height="2" />
                            <rect x="8" y="1" width="2" height="2" />
                            <rect x="10" y="3" width="2" height="2" />
                            <rect x="4" y="4" width="4" height="1" />
                            <rect x="3" y="5" width="6" height="3" />
                            <rect x="4" y="8" width="4" height="1" />
                        </svg>
                    </button>
                    <ThemeToggle />
                </div>

                <button class="menu-toggle relative z-30" aria-label="Open Menu" aria-expanded="false" aria-controls="menu-items">
                    <span class="menu-toggle-open" aria-hidden="true">Menu</span>
                    <span class="menu-toggle-close" aria-hidden="true">Close</span>
                    <span class="menu-toggle-icon" aria-hidden="true" />
                </button>
            </div>
        )
    }
</nav>

<style>
    @reference "tailwindcss";

    .masthead {
        min-height: 2.75rem;
    }

    .masthead::after {
        content: '';
        position: absolute;
        right: 0;
        bottom: -0.875rem;
        left: 0;
        border-bottom: 1px dashed color-mix(in oklab, var(--border-main) 25%, transparent);
    }

    .brand-mark {
        transition: color 0.2s ease;
    }

    .brand-mark:hover {
        color: var(--text-main);
    }

    :global(.masthead-link:focus-visible),
    .menu-toggle:focus-visible,
    .tool-button:focus-visible,
    :global(#theme-toggle:focus-visible) {
        border-radius: 0.125rem;
        outline: 1.5px dashed var(--accent);
        outline-offset: 0.2rem;
    }

    .menu-toggle {
        display: inline-flex;
        min-height: 2.75rem;
        cursor: pointer;
        align-items: center;
        gap: 0.625rem;
        border: 0;
        background: transparent;
        padding: 0 0.125rem 0 0.75rem;
        color: var(--text-main);
        font-family: var(--font-serif);
        font-size: 0.9375rem;
    }

    .menu-toggle-close {
        display: none;
    }

    .menu-toggle.is-active .menu-toggle-open {
        display: none;
    }

    .menu-toggle.is-active .menu-toggle-close {
        display: inline;
    }

    .menu-toggle-icon {
        position: relative;
        width: 1.25rem;
        height: 1px;
        background-color: currentColor;
        transition: background-color 0.15s ease;
    }

    .menu-toggle-icon::before,
    .menu-toggle-icon::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1.25rem;
        height: 1px;
        transform-origin: center;
        background-color: currentColor;
        transition: transform 0.2s ease;
    }

    .menu-toggle-icon::before {
        transform: translate(-50%, -50%) translateY(-0.3rem);
    }

    .menu-toggle-icon::after {
        transform: translate(-50%, -50%) translateY(0.3rem);
    }

    .menu-toggle.is-active .menu-toggle-icon {
        background-color: transparent;
    }

    .menu-toggle.is-active .menu-toggle-icon::before {
        transform: translate(-50%, -50%) rotate(45deg);
    }

    .menu-toggle.is-active .menu-toggle-icon::after {
        transform: translate(-50%, -50%) rotate(-45deg);
    }

    .tool-button {
        display: inline-flex;
        width: 2rem;
        height: 2rem;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        color: var(--text-main);
        transition: color 0.2s ease;
    }

    .tool-button:hover {
        color: var(--accent);
    }

    .tools-label {
        display: none;
    }

    @media (max-width: 899px) {
        .brand-mark {
            grid-column: 1;
            grid-row: 1;
            justify-self: start;
        }

        .menu-toggle {
            grid-column: 3;
            grid-row: 1;
            justify-self: end;
        }

        .menu {
            position: fixed;
            z-index: 20;
            inset: 0;
            display: flex;
            visibility: hidden;
            height: 100dvh;
            min-height: 32rem;
            pointer-events: none;
            flex-direction: column;
            overflow-y: auto;
            background-color: var(--bg-main);
            background-image: radial-gradient(var(--dot-grid) 1px, transparent 1px);
            background-size: 24px 24px;
            padding: 5.75rem max(1.25rem, env(safe-area-inset-right)) calc(5.75rem + env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
            opacity: 0;
            transform: translateY(-0.5rem);
            transition:
                visibility 0s linear 0.25s,
                opacity 0.25s ease,
                transform 0.25s ease;
        }

        .menu.is-visible {
            visibility: visible;
            pointer-events: auto;
            opacity: 1;
            transform: translateY(0);
            transition:
                opacity 0.25s ease,
                transform 0.25s ease;
        }

        .menu-meta,
        .menu-edition,
        .menu-list {
            width: min(100%, 32rem);
            margin-inline: auto;
        }

        .menu-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid color-mix(in oklab, var(--border-main) 45%, transparent);
            color: var(--text-muted);
            font-family: var(--font-sans);
            font-size: 0.625rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .menu-list {
            display: flex;
            flex: 1;
            flex-direction: column;
            justify-content: center;
            padding-block: clamp(1rem, 4vh, 2.5rem);
        }

        .menu-item {
            display: grid;
            grid-template-columns: 2.25rem minmax(0, 1fr);
            align-items: baseline;
        }

        .menu-number {
            color: var(--accent);
            font-family: var(--font-sans);
            font-size: 0.625rem;
            font-weight: 650;
            letter-spacing: 0.12em;
        }

        :global(.masthead-link) {
            display: inline-flex;
            width: fit-content;
            min-height: 2.75rem;
            align-items: center;
            color: var(--text-main);
            font-family: var(--font-serif);
            font-size: clamp(2rem, min(10vw, 6.4vh), 4rem);
            font-weight: 450;
            line-height: 0.95;
            letter-spacing: -0.035em;
        }

        :global(.masthead-link.is-active) {
            color: var(--accent);
            font-style: italic;
        }

        .menu-edition {
            padding-top: 0.75rem;
            border-top: 1px solid color-mix(in oklab, var(--border-main) 45%, transparent);
            color: var(--text-muted);
            font-family: var(--font-sans);
            font-size: 0.625rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .nav-tools {
            position: fixed;
            z-index: 30;
            right: max(1.25rem, env(safe-area-inset-right));
            bottom: calc(1.15rem + env(safe-area-inset-bottom));
            left: max(1.25rem, env(safe-area-inset-left));
            display: flex;
            visibility: hidden;
            pointer-events: none;
            justify-content: flex-end;
            gap: 0.125rem;
            opacity: 0;
            transition:
                visibility 0s linear 0.2s,
                opacity 0.2s ease;
        }

        .tools-label {
            display: inline-flex;
            flex: 1;
            align-items: center;
            color: var(--text-muted);
            font-family: var(--font-sans);
            font-size: 0.625rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        :global(body.menu-open) .nav-tools {
            visibility: visible;
            pointer-events: auto;
            opacity: 1;
            transition: opacity 0.2s ease 0.08s;
        }

        :global(body.menu-open) {
            overflow: hidden;
        }

        :global(body.menu-open) .brand-mark {
            position: fixed;
            z-index: 30;
            top: calc(1rem + env(safe-area-inset-top));
            left: max(1.25rem, env(safe-area-inset-left));
        }
    }

    @media (min-width: 900px) {
        .masthead {
            grid-template-columns: minmax(5rem, 1fr) auto minmax(5rem, 1fr);
        }

        .menu {
            grid-column: 2;
            grid-row: 1;
        }

        .menu-list {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: clamp(0.75rem, 1.7vw, 1.5rem);
        }

        .menu-item {
            display: block;
        }

        .menu-number,
        .menu-meta,
        .menu-edition {
            display: none;
        }

        :global(.masthead-link) {
            display: inline-flex;
            min-height: 2rem;
            align-items: center;
            color: var(--text-main);
            font-family: var(--font-serif);
            font-size: clamp(0.8rem, 1.15vw, 0.9375rem);
            font-weight: 500;
            white-space: nowrap;
        }

        :global(.masthead-link.is-active) {
            color: var(--accent);
            font-style: italic;
        }

        .nav-tools {
            grid-column: 3;
            grid-row: 1;
        }

        .menu-toggle {
            display: none;
        }
    }

    @media (min-width: 900px) and (max-width: 1040px) {
        .menu-list {
            gap: 0.625rem;
        }

        :global(.masthead-link) {
            font-size: 0.75rem;
        }
    }

    @media (max-width: 360px), (max-height: 620px) {
        .menu {
            padding-top: 4.75rem;
            padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
        }

        .menu-list {
            padding-block: 0.75rem;
        }

        :global(.masthead-link) {
            min-height: 2.25rem;
            font-size: clamp(1.75rem, min(9vw, 5.8vh), 2.75rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .brand-mark,
        .menu,
        .menu.is-visible,
        .nav-tools,
        .menu-toggle-icon,
        .menu-toggle-icon::before,
        .menu-toggle-icon::after,
        .tool-button {
            transition: none;
        }
    }
</style>

<script>
    function initializeMenu() {
        const menu = document.querySelector<HTMLElement>('.menu');
        const menuToggleBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
        if (!menu || !menuToggleBtn || menuToggleBtn.dataset.initialized === 'true') return;

        const menuWindow = window as Window & { cleanupMobileMenu?: () => void };
        menuWindow.cleanupMobileMenu?.();
        menuToggleBtn.dataset.initialized = 'true';
        const mobileQuery = window.matchMedia('(max-width: 899px)');

        function setMenuOpen(open: boolean, returnFocus = false) {
            const shouldOpen = open && mobileQuery.matches;
            menuToggleBtn?.classList.toggle('is-active', shouldOpen);
            menuToggleBtn?.setAttribute('aria-expanded', String(shouldOpen));
            menuToggleBtn?.setAttribute('aria-label', shouldOpen ? 'Close Menu' : 'Open Menu');
            menu?.classList.toggle('is-visible', shouldOpen);
            menu?.setAttribute('aria-hidden', mobileQuery.matches ? String(!shouldOpen) : 'false');
            document.body.classList.toggle('menu-open', shouldOpen);
            if (returnFocus) menuToggleBtn?.focus();
        }

        setMenuOpen(false);

        menuToggleBtn.addEventListener('click', () => {
            const willOpen = menuToggleBtn.getAttribute('aria-expanded') !== 'true';
            setMenuOpen(willOpen);
            if (willOpen) {
                window.setTimeout(() => menu?.querySelector<HTMLAnchorElement>('a')?.focus(), 260);
            }
        });

        menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
        function handleKeydown(event: KeyboardEvent) {
            if (event.key === 'Escape' && menuToggleBtn.getAttribute('aria-expanded') === 'true') {
                setMenuOpen(false, true);
            }
        }

        function handleBreakpointChange() {
            setMenuOpen(false);
        }

        document.addEventListener('keydown', handleKeydown);
        mobileQuery.addEventListener('change', handleBreakpointChange);
        menuWindow.cleanupMobileMenu = () => {
            document.removeEventListener('keydown', handleKeydown);
            mobileQuery.removeEventListener('change', handleBreakpointChange);
            document.body.classList.remove('menu-open');
        };
    }

    initializeMenu();
    document.addEventListener('astro:after-swap', initializeMenu);
</script>
