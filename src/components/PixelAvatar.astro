---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div
    class:list={['pixel-avatar', className]}
    role="img"
    aria-label="Pixel art avatar of Pranav that puts on headphones when hovered"
    title="Hover me"
>
</div>

<style>
    /* 5-frame sprite sheet (P1–P5 appended horizontally): idle → grab → lift → place → worn */
    .pixel-avatar {
        width: 10rem;
        height: 10rem;
        flex-shrink: 0;
        background-image: url('/GIFS/avatar-sheet.png');
        background-size: 500% 100%;
        background-position: 0% 0;
        background-repeat: no-repeat;
        image-rendering: pixelated;
    }

    @media (min-width: 640px) {
        .pixel-avatar {
            width: 13rem;
            height: 13rem;
        }
    }

    /* steps(4) walks the 4 frame boundaries; forwards holds "worn".
       Un-hovering removes the animation, snapping back to idle. */
    .pixel-avatar:hover {
        animation: avatar-headphones 0.7s steps(4) forwards;
    }

    @keyframes avatar-headphones {
        from {
            background-position: 0% 0;
        }
        to {
            background-position: 100% 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .pixel-avatar,
        .pixel-avatar:hover {
            animation: none;
            background-position: 100% 0; /* headphones on, no motion */
        }
    }
</style>
