---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    return [{ params: { page: undefined }, props: { projects } }];
}

type Props = { projects: CollectionEntry<'projects'>[] };

const { projects } = Astro.props;
---

<BaseLayout
    title="Portfolio"
    description="Explore a diverse portfolio showcasing my passion and expertise"
    image={{ src: '/dante-preview.jpg', alt: 'The preview of the site' }}
    showHeader={false}
>
    <h1 class="mb-12 text-xl leading-tight font-display heading-accent sm:mb-16 sm:text-3xl">Projects</h1>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {projects.map((project) => <ProjectPreview project={project} class="reveal" />)}
    </div>
</BaseLayout>
