---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc, getAllTags, getAllToolTags, getPostsByTag, getProjectsByTool } from '../../utils/data-utils';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
const topics = getAllTags(posts).sort((tagA, tagB) => {
    const postCountTagA = getPostsByTag(posts, tagA.id).length;
    const postCountTagB = getPostsByTag(posts, tagB.id).length;
    return postCountTagB - postCountTagA;
});
const tools = getAllToolTags(projects).sort((toolA, toolB) => {
    const projectCountToolA = getProjectsByTool(projects, toolA.id).length;
    const projectCountToolB = getProjectsByTool(projects, toolB.id).length;
    return projectCountToolB - projectCountToolA || toolA.name.localeCompare(toolB.name);
});
---

<BaseLayout
    title="Topics & Tools"
    description="Browse writing topics and the tools used across projects."
    showHeader={false}
>
    <section class="tag-directory" aria-labelledby="tag-directory-title">
        <header class="tag-directory__heading">
            <span class="tag-directory__eyebrow">Browse the workbench</span>
            <h1 id="tag-directory-title" class="text-xl leading-tight font-display heading-accent sm:text-3xl">Topics &amp; Tools</h1>
            <p>Follow an idea through the writing, or see the projects built with a particular tool.</p>
        </header>

        <div class="tag-directory__sections">
            <section aria-labelledby="tools-title">
                <div class="tag-directory__section-heading">
                    <h2 id="tools-title">Project tools</h2>
                    <span>{tools.length} in use</span>
                </div>
                <div class="tag-cloud tag-cloud--tools">
                    {tools.map((tool) => {
                        const projectCount = getProjectsByTool(projects, tool.id).length;
                        return <a class="tool-tag" href={`/tags/${tool.id}`}>{tool.name}<small>{projectCount}</small></a>;
                    })}
                </div>
            </section>

            <section aria-labelledby="topics-title">
                <div class="tag-directory__section-heading">
                    <h2 id="topics-title">Writing topics</h2>
                    <span>{topics.length} subjects</span>
                </div>
                <div class="tag-cloud">
                    {topics.map((tag) => {
                        const postCount = getPostsByTag(posts, tag.id).length;
                        return <a class="topic-tag" href={`/tags/${tag.id}`}>{tag.name}<small>{postCount}</small></a>;
                    })}
                </div>
            </section>
        </div>
    </section>
</BaseLayout>

<style>
    .tag-directory { max-width: 58rem; margin: 0 auto 6rem; }
    .tag-directory__heading { max-width: 42rem; margin-bottom: 3rem; }
    .tag-directory__eyebrow, .tag-directory__section-heading span { color: var(--blueprint-ink); font-size: .625rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
    .tag-directory__eyebrow { display: block; margin-bottom: .65rem; }
    .tag-directory__heading p { max-width: 34rem; margin-top: .85rem; color: var(--text-muted); font-family: var(--font-serif); font-size: clamp(1.05rem, 2.2vw, 1.35rem); line-height: 1.35; }
    .tag-directory__sections { display: grid; gap: 2.75rem; }
    .tag-directory__section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; padding-bottom: .65rem; border-bottom: 1px dashed color-mix(in oklab, var(--border-main) 36%, transparent); }
    .tag-directory__section-heading h2 { font-family: var(--font-display); font-size: 1rem; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: .6rem; }
    .topic-tag, .tool-tag { display: inline-flex; align-items: center; gap: .55rem; border: 1px solid color-mix(in oklab, var(--border-main) 55%, transparent); border-radius: 999px; padding: .55rem .75rem .5rem .9rem; color: var(--text-main); font-family: var(--font-serif); font-size: 1.05rem; line-height: 1; transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; }
    .topic-tag:hover, .topic-tag:focus-visible { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
    .tool-tag { border-color: color-mix(in oklab, var(--blueprint-ink) 62%, transparent); background: color-mix(in oklab, var(--blueprint-paper) 82%, transparent); color: var(--blueprint-ink); }
    .tool-tag:hover, .tool-tag:focus-visible { border-color: var(--blueprint-ink); background: var(--blueprint-ink); color: var(--blueprint-paper); transform: translateY(-2px); }
    .topic-tag small, .tool-tag small { display: grid; width: 1.15rem; height: 1.15rem; place-items: center; border-radius: 999px; background: color-mix(in oklab, currentColor 12%, transparent); font-family: var(--font-sans); font-size: .625rem; font-weight: 700; }
    @media (min-width: 720px) { .tag-directory__sections { grid-template-columns: 1fr 1fr; gap: 3rem; } }
</style>
